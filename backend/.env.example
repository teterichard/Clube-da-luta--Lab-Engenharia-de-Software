PORT=3000
JWT_SECRET=troque-este-segredo
# validade do token emitido no login (formato do jsonwebtoken: 7d, 12h...)
JWT_EXPIRES_IN=7d
# true = sobe a API sem MySQL (dados em memória)
DB_IN_MEMORY=false
# Banco: ou uma URL única (Railway: MYSQL_URL; outros: DATABASE_URL)...
# DATABASE_URL=mysql://usuario:senha@host:3306/topaai
# ...ou as variáveis separadas:
DB_HOST=localhost
DB_PORT=3306
DB_USER=topaai
DB_PASSWORD=topaai
DB_NAME=topaai
# true quando o provedor exige SSL (ex.: Azure Database for MySQL)
DB_SSL=false
# false = não rodar db/schema.sql ao subir a API
DB_AUTO_SCHEMA=true

# Endereço do front em produção (CORS), separado por vírgula. Ex.: https://topa-ai.vercel.app
CORS_ORIGIN=
# Em produção (NODE_ENV=production) a API não sobe com o JWT_SECRET padrão
